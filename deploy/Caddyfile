# Proxy de borde de producción (D2 de openspec/changes/despliegue-continuo-ec2).
#
# SITE_ADDRESS define la etapa (sale de SITE_ADDRESS en /opt/reservas/.env del servidor):
# - `:80`: etapa transitoria en HTTP, en la IP pública, mientras el subdominio no apunte a la
#   instancia. Sin certificado ni HSTS.
# - `<subdominio>`: etapa HTTPS. Caddy obtiene y renueva solo el certificado de Let's Encrypt
#   (desafío HTTP-01 por el puerto 80), redirige HTTP a HTTPS y sirve por 443.
#
# Origen del visitante (change ip-real-detras-de-cloudflare). El sitio público pasa por
# Cloudflare con proxy, así que la conexión que ve Caddy es la de un borde de Cloudflare, no la
# del visitante. Caddy resuelve la IP real así:
# - Solo confía en `CF-Connecting-IP` cuando la conexión viene de un rango de Cloudflare
#   (`trusted_proxies`, abajo). Desde cualquier otra dirección, el origen es la propia conexión
#   y ese encabezado se ignora.
# - Hacia el frontend escribe un único `X-Forwarded-For` con esa IP y descarta `X-Real-IP`,
#   `Forwarded` y `CF-Connecting-IP`: lo que escriba el visitante no pasa. El backend confía
#   solo en ese salto (TRUST_PROXY, ver docker-compose.prod.yml) y cuenta sus límites por esa IP.
# - La lista de rangos tiene UNA fuente: deploy/cloudflare-ips.txt. La línea `trusted_proxies
#   static` de abajo es una copia de ese archivo (Caddy no admite leerla de otro lado en esa
#   directiva) y una prueba (scripts/cd/verificar-rangos-cloudflare.test.mjs) falla si difieren.
# Ver https://caddyserver.com/docs/caddyfile/options#trusted-proxies
# y https://caddyserver.com/docs/caddyfile/directives/reverse_proxy#defaults
{
	# Sin `email`: Let's Encrypt ya no manda avisos de vencimiento por correo (desde el 4 de
	# junio de 2025). El vencimiento lo controla .github/workflows/certificado.yml (D2).

	servers {
		# Sin HTTP/3: el security group solo abre TCP 80 y 443, y anunciar h3 por UDP haría
		# que los navegadores intenten una conexión que no llega.
		protocols h1 h2

		# Rangos de Cloudflare en los que se confía para leer CF-Connecting-IP.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_ADDRESS} {
	# Encabezados de seguridad que no dependen de HTTPS (spec: "Encabezados de seguridad").
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No exponer la versión del servidor ni del framework. Borrar un encabezado difiere la
		# operación hasta la respuesta, así que también quita el X-Powered-By que pone Next.
		-Server
		-X-Powered-By
		-Via
	}

	# HSTS solo en la etapa HTTPS. Sin includeSubDomains ni preload: el dominio padre es de la
	# docente y no le corresponde a este proyecto fijar política para sus otros subdominios.
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000"

	# Todo va al frontend; el backend no tiene ruta propia en el proxy (D1). Next reescribe
	# /api hacia el backend por la red interna.
	reverse_proxy frontend:3000 {
		header_up X-Forwarded-For {client_ip}
		header_up -X-Real-IP
		header_up -Forwarded
		header_up -CF-Connecting-IP
	}
}
