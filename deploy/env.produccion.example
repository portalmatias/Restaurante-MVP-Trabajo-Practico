# Plantilla de /opt/reservas/.env, el archivo con las variables de producción del SERVIDOR.
# NO se commitea con valores reales (este repositorio es público). Se crea a mano en el servidor
# (docs/despliegue.md, §4.3): de root y con modo 600; deploy/desplegar.sh lo exige.
# El archivo se lee línea por línea, sin ejecutarse: no uses `$(...)` ni comillas dentro del valor.

# 32 caracteres o más, solo A-Z a-z 0-9 _ -  (openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n')
JWT_SECRET=
# 24 caracteres o más, solo A-Z a-z 0-9 _ -  (va dentro de una URL de conexión)
POSTGRES_PASSWORD=
# Admin de producción: ni el email ni la contraseña del README. Contraseña de 16 caracteres o más.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# `:80` en la etapa HTTP (sin subdominio); el nombre del subdominio en minúsculas en la etapa HTTPS.
SITE_ADDRESS=:80
