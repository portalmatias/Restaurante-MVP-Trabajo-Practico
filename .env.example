# Plantilla de variables de entorno. Copiar a `.env` y completar valores locales.
# `.env` está en .gitignore y NUNCA se commitea. Este repositorio es público:
# no pongas acá valores reales, secretos ni credenciales de un entorno real.

# Cadena de conexión a PostgreSQL. El host y puerto corresponden al servicio de
# docker-compose.yml; la base `reservas_dev` es la de desarrollo (ver §10).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reservas_dev"

# Secreto para firmar los JWT de acceso del admin (§5). Generar un valor propio para
# desarrollo local; nunca reutilizar este ni commitear el real.
JWT_SECRET="reemplazar-por-un-secreto-local-de-desarrollo"

# Vida del JWT de acceso del admin. En el MVP es de 60 minutos (§5).
JWT_EXPIRES_IN="60m"

# Puerto donde escucha el backend (NestJS).
PORT=3001

# Interfaz de red donde escucha el backend. Sin definir (o vacía), escucha solo en
# `127.0.0.1`: ningún otro equipo de la red llega al backend. `HOST=0.0.0.0` lo expone a toda
# la red local; usalo solo a propósito y por el tiempo que haga falta (ver README, "Red y
# límites de solicitudes").
# HOST=127.0.0.1

# Proxies en los que confía el backend para tomar la IP del cliente de `X-Forwarded-For`.
# Vacío (el default): no confía en ninguno y cuenta los límites por la conexión. En local
# tiene que quedar vacío. Para un despliegue detrás de un proxy de borde que SOBRESCRIBA
# `X-Forwarded-For`: lista separada por coma de `loopback`, `linklocal`, `uniquelocal`,
# direcciones IPv4 (`10.0.0.5`) o subredes IPv4 con prefijo `/8` o mayor (`10.0.0.0/8`).
# Nunca `true`, `*` ni un número de saltos: cualquier cliente podría inventar su IP y
# saltear los límites. El backend no arranca con un valor fuera de esos formatos.
TRUST_PROXY=

# URL pública del backend que consume el frontend (Next.js) desde el navegador.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Rate limiting (@nestjs/throttler) de las rutas públicas de consulta/cancelación de
# reservas sin cuenta (§5): ventana en segundos y cantidad máxima de peticiones por ventana.
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# Cadena de conexión a la base de PostgreSQL usada por `npm run test:integration -w backend`
# (backend/test/*.integration-spec.ts). Opcional: si no se define, cae al fallback
# `postgresql://postgres:postgres@localhost:5432/reservas_test`, que ya crea
# docker/postgres/init-databases.sql.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/reservas_test"
